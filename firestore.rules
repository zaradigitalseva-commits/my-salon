rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in ['ngogrant454@gmail.com','zaradigitalseva@gmail.com'];}
  function owns(salonId){return signedIn() && exists(/databases/$(database)/documents/salons/$(salonId)) && get(/databases/$(database)/documents/salons/$(salonId)).data.ownerUid == request.auth.uid && get(/databases/$(database)/documents/salons/$(salonId)).data.status in ['LIVE','ACTIVE','APPROVED'];}
  function ownerOfData(){return signedIn() && resource.data.ownerUid == request.auth.uid && owns(resource.data.salonId);}
  match /publicSettings/{id}{allow read:if true;allow write:if isAdmin();}
  match /salons/{id}{
   allow read:if isAdmin() || (signedIn() && resource.data.ownerUid==request.auth.uid) || resource.data.status in ['LIVE','ACTIVE','APPROVED'];
   allow create:if signedIn() && request.resource.data.ownerUid==request.auth.uid && request.resource.data.status=='PENDING_PAYMENT' && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=100 && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{10}$') && request.resource.data.planFee==599;
   allow update:if isAdmin() || (signedIn() && resource.data.ownerUid==request.auth.uid && resource.data.status=='PENDING_PAYMENT' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['utr','paymentProofUrl','paymentStatus','updatedAt']) && request.resource.data.utr is string && request.resource.data.utr.size()>=6 && request.resource.data.utr.size()<=40 && request.resource.data.paymentProofUrl is string && request.resource.data.paymentProofUrl.matches('https://.*') && request.resource.data.paymentStatus=='SUBMITTED_FOR_REVIEW') || (signedIn() && resource.data.ownerUid==request.auth.uid && resource.data.status in ['LIVE','ACTIVE','APPROVED'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsapp','description','utr','paymentProofUrl','paymentStatus','planFee','updatedAt']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['whatsapp']) || (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size()<=15));
   allow delete:if isAdmin();
  }
  match /salonServices/{id}{
   allow read:if resource.data.active==true || isAdmin() || ownerOfData();
   allow create:if signedIn() && request.resource.data.ownerUid==request.auth.uid && owns(request.resource.data.salonId) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=100 && request.resource.data.price is number && request.resource.data.price>=0;
   allow update,delete:if ownerOfData() || isAdmin();
  }
  match /salonOffers/{id}{
   allow read:if resource.data.active==true || isAdmin() || ownerOfData();
   allow create:if signedIn() && request.resource.data.ownerUid==request.auth.uid && owns(request.resource.data.salonId) && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=120;
   allow update,delete:if ownerOfData() || isAdmin();
  }
  match /appointments/{id}{
   allow create:if signedIn() && request.resource.data.customerUid==request.auth.uid && request.resource.data.status=='PENDING' && request.resource.data.serviceName is string && request.resource.data.serviceName.size()<=120 && exists(/databases/$(database)/documents/salons/$(request.resource.data.salonId)) && get(/databases/$(database)/documents/salons/$(request.resource.data.salonId)).data.status in ['LIVE','ACTIVE','APPROVED'];
   allow read:if isAdmin() || (signedIn() && resource.data.customerUid==request.auth.uid) || (signedIn() && owns(resource.data.salonId) && get(/databases/$(database)/documents/salons/$(resource.data.salonId)).data.ownerUid==request.auth.uid);
   allow update:if isAdmin() || (signedIn() && owns(resource.data.salonId) && get(/databases/$(database)/documents/salons/$(resource.data.salonId)).data.ownerUid==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['CONFIRMED','REJECTED']);
   allow delete:if isAdmin();
  }
  match /salonCustomers/{id}{
   allow create:if signedIn() && request.resource.data.ownerUid==request.auth.uid && owns(request.resource.data.salonId) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=80 && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{10}$') && request.resource.data.customerUid==null;
   allow read:if isAdmin() || ownerOfData() || (signedIn() && resource.data.customerUid==request.auth.uid);
   allow update:if isAdmin() || (signedIn() && resource.data.ownerUid==request.auth.uid && owns(resource.data.salonId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','visitCount','updatedAt']));
   allow delete:if isAdmin() || ownerOfData();
  }
  match /salonVisits/{id}{
   allow create:if signedIn() && request.resource.data.ownerUid==request.auth.uid && owns(request.resource.data.salonId) && request.resource.data['service'] is string && request.resource.data['service'].size()>0 && request.resource.data.amount is number && request.resource.data.amount>=0 && request.resource.data.discount is number && request.resource.data.discount>=0 && request.resource.data.discount<=request.resource.data.amount && request.resource.data.paidAmount==request.resource.data.amount-request.resource.data.discount;
   allow read:if isAdmin() || ownerOfData() || (signedIn() && resource.data.customerUid==request.auth.uid);
   allow update,delete:if isAdmin() || ownerOfData();
  }
  match /{document=**}{allow read,write:if false;}
 }
}